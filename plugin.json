{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "todo-tracker",
  "version": "0.1.0",
  "description": "Finds TODO and FIXME markers, reports the unowned ones, and helps triage them across Codex, Claude Code, Antigravity, and Pi.",
  "author": {
    "name": "Ryan Minato",
    "url": "https://github.com/ryan-minato"
  },
  "homepage": "https://ryan-minato.github.io/universal-agent-extension-template/",
  "repository": "https://github.com/ryan-minato/universal-agent-extension-template",
  "license": "Apache-2.0",
  "keywords": ["todo", "fixme", "code-quality", "agent-plugin", "template"],
  "extensions": {
    "com.openai": {
      "hooks": "./integrations/codex/hooks/hooks.json"
    }
  }
}
