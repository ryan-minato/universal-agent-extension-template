  "license": "Apache-2.0",
  "keywords": [
    "todo",
    "fixme",
    "code-quality",
    "agent-plugin",
    "template"
  ],
  "commands": "./integrations/claude-code/commands",
  "hooks": "./integrations/claude-code/hooks/hooks.json",
  "agents": [
    "./.claude-plugin/agents/todo-triager.md"
  ]
}
